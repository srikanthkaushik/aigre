# Rendered by the nginx image's entrypoint (envsubst over /etc/nginx/templates/*.template)
# into /etc/nginx/conf.d/default.conf. Only variables set in the environment are
# substituted, so nginx's own $vars are left alone.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location / {
        index index.html;
        # Point the page's default AIGRE instance at this deployment's app.
        sub_filter '<meta name="aigre-api" content="http://localhost:8085">'
                   '<meta name="aigre-api" content="${AIGRE_API_ORIGIN}">';
        sub_filter_once on;
        add_header Cache-Control "no-cache";
    }
}
