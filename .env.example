# Copy to .env next to docker-compose.yml and fill in. .env is gitignored -- never commit it.
# With Unraid's Compose Manager plugin, paste these into the stack's Edit Stack -> Env File.

# Required. Signs employee logins and citizen-recognition tokens.
# Generate with: openssl rand -base64 32
AIGRE_JWT_SECRET=

# Required. Ollama on the GPU machine, as this box reaches it over the LAN.
AIGRE_OLLAMA_BASE_URL=http://<gpu-machine-ip>:11434

# Required. The app's origin as LAN browsers reach it (this box's IP, host port 8087).
AIGRE_LAN_ORIGIN=http://<this-box-ip>:8087

# Domain profile. Empty = city departments (database "aigre"); "dmv" = NH DMV bureaus, which
# needs its own database (see docs/RUNNING.md "Running the DMV profile").
AIGRE_PROFILE=dmv
AIGRE_DB_NAME=aigre_dmv

# Which department the embed demo's widget is scoped to. Empty = agency-wide (dmv profile only);
# for the city profile set a department id, e.g. DMV.
AIGRE_EMBED_DEPARTMENT=

# Optional. The app's public hostname behind the Cloudflare tunnel. When set, it's added to
# the app's CORS list and becomes the embed demo's default AIGRE origin.
AIGRE_APP_PUBLIC_ORIGIN=

# Optional. Connector token for the named tunnel (only used with --profile tunnel).
# From the Cloudflare dashboard's Docker install command: the eyJ... string after --token.
CLOUDFLARE_TUNNEL_TOKEN=
